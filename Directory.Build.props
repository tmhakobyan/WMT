<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>4.1.0</Version>
    <InformationalVersion>4.1.0-beta</InformationalVersion>
    <Company>WMT</Company>
    <Product>Workstation Migration Toolkit</Product>
    <NoWarn>$(NoWarn);CA1416;CS1998</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
