<Window x:Class="WMT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workstation Migration Toolkit" Width="1280" Height="820" MinWidth="900" MinHeight="600"
        FontFamily="Segoe UI, Sylfaen" FontSize="13" UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="300" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="110" MinHeight="50" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Padding="2">
            <MenuItem Header="Help" Click="OnHelp" />
            <MenuItem Header="Open log" Click="OnOpenLog" />
            <MenuItem Header="Open log folder" Click="OnOpenLogFolder" />
            <MenuItem Header="About" Click="OnAbout" />
        </Menu>

        <TabControl Grid.Row="1" Margin="6,4,6,2" x:Name="MainTabs">
            <!-- ============================ SOFTWARE ============================ -->
            <TabItem Header="Software">
                <Grid Margin="6" IsEnabled="{Binding IsIdle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="160" MinHeight="40" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <Button Content="Discover software" Command="{Binding DiscoverSoftwareCommand}" FontWeight="SemiBold" />
                        <CheckBox Content="Also query winget" IsChecked="{Binding IncludeWinget}" VerticalAlignment="Center" Margin="0,0,14,6" />
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,4,6" />
                        <TextBox Width="200" Margin="0,0,10,6" Text="{Binding SoftwareSearch, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,4,6" />
                        <ComboBox Width="120" Margin="0,0,10,6" ItemsSource="{Binding SoftwareCategories}" SelectedItem="{Binding SoftwareCategory}" />
                        <TextBlock Text="Group by:" VerticalAlignment="Center" Margin="0,0,4,6" />
                        <ComboBox Width="130" Margin="0,0,10,6" ItemsSource="{Binding SoftwareGroups}" SelectedItem="{Binding SoftwareGroup}" />
                        <Button Content="Select all" Command="{Binding SelectSoftwareCommand}" CommandParameter="all" />
                        <Button Content="Clear" Command="{Binding SelectSoftwareCommand}" CommandParameter="none" />
                        <Button Content="Invert" Command="{Binding SelectSoftwareCommand}" CommandParameter="invert" />
                        <Button Content="Export list" Command="{Binding ExportSoftwareCommand}" />
                    </WrapPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,4">
                        <TextBlock Text="{Binding SoftwareStatus}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SoftwareSelectionText}" FontWeight="SemiBold" />
                    </StackPanel>
                    <DataGrid Grid.Row="2" x:Name="SoftwareGrid" ItemsSource="{Binding SoftwareView}" CanUserSortColumns="True">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="Bold" Margin="2,6,0,2">
                                            <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="(" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Selected" Width="62" SortMemberPath="IsSelected">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Width="2*" IsReadOnly="True" Binding="{Binding Item.Name, Mode=OneWay}" />
                            <DataGridTextColumn Header="Publisher" Width="*" IsReadOnly="True" Binding="{Binding Item.Publisher, Mode=OneWay}" />
                            <DataGridTextColumn Header="Version" Width="100" IsReadOnly="True" Binding="{Binding Item.Version, Mode=OneWay}" />
                            <DataGridTextColumn Header="Build" Width="80" IsReadOnly="True" Binding="{Binding Item.Build, Mode=OneWay}" />
                            <DataGridTextColumn Header="Architecture" Width="80" IsReadOnly="True" Binding="{Binding Item.Architecture, Mode=OneWay}" />
                            <DataGridTextColumn Header="Installation Type" Width="100" IsReadOnly="True" Binding="{Binding Item.InstallationType, Mode=OneWay}" />
                            <DataGridTextColumn Header="Install Location" Width="*" IsReadOnly="True" Binding="{Binding Item.InstallLocation, Mode=OneWay}" />
                            <DataGridTextColumn Header="Detected Source" Width="110" IsReadOnly="True" Binding="{Binding Item.DetectedSource, Mode=OneWay}" />
                            <DataGridTextColumn Header="Type" Width="80" IsReadOnly="True" Binding="{Binding Item.Category, Mode=OneWay}" />
                            <DataGridTextColumn Header="Recovery Method" Width="*" IsReadOnly="True" Binding="{Binding Item.RecoveryMethod, Mode=OneWay}" />
                            <DataGridTextColumn Header="Dependency Status" Width="*" IsReadOnly="True" Binding="{Binding DependencyStatus, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="3" Style="{StaticResource HSplit}" />
                    <GroupBox Grid.Row="4" Header="Office details">
                        <DockPanel>
                            <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Show Office details" Command="{Binding OfficeDetailsCommand}" Margin="0,4,0,4" />
                            <TextBox Text="{Binding OfficeText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" />
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============================ USER PROFILES ============================ -->
            <TabItem Header="User Profiles">
                <Grid Margin="6" IsEnabled="{Binding IsIdle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="100" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <Button Content="Discover profiles" Command="{Binding DiscoverProfilesCommand}" FontWeight="SemiBold" />
                        <Button Content="Select all" Command="{Binding SelectProfilesCommand}" CommandParameter="all" />
                        <Button Content="Clear" Command="{Binding SelectProfilesCommand}" CommandParameter="none" />
                        <Button Content="Invert" Command="{Binding SelectProfilesCommand}" CommandParameter="invert" />
                        <Button Content="Select current user" Command="{Binding SelectProfilesCommand}" CommandParameter="current" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Text="{Binding ProfilesStatus}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Profiles}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Selected" Width="62">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Account" Width="*" IsReadOnly="True" Binding="{Binding Item.Account, Mode=OneWay}" />
                            <DataGridTextColumn Header="SID" Width="1.5*" IsReadOnly="True" Binding="{Binding Item.Sid, Mode=OneWay}" />
                            <DataGridTextColumn Header="Profile path" Width="1.2*" IsReadOnly="True" Binding="{Binding Item.ProfilePath, Mode=OneWay}" />
                            <DataGridTextColumn Header="Loaded" Width="60" IsReadOnly="True" Binding="{Binding LoadedText, Mode=OneWay}" />
                            <DataGridTextColumn Header="Accessible" Width="90" IsReadOnly="True" Binding="{Binding AccessText, Mode=OneWay}" />
                            <DataGridTextColumn Header="Last used" Width="120" IsReadOnly="True" Binding="{Binding LastUsedText, Mode=OneWay}" />
                            <DataGridTextColumn Header="Note" Width="2*" IsReadOnly="True" Binding="{Binding Item.AccessNote, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Grid.Row="3" Header="User data folders of the selected profiles (opt-in; scanned only when you generate the plan)" Margin="0,6,0,0">
                        <WrapPanel Margin="4">
                            <CheckBox Content="Desktop" IsChecked="{Binding UdDesktop}" Margin="0,0,14,4" />
                            <CheckBox Content="Documents" IsChecked="{Binding UdDocuments}" Margin="0,0,14,4" />
                            <CheckBox Content="Downloads" IsChecked="{Binding UdDownloads}" Margin="0,0,14,4" />
                            <CheckBox Content="Pictures" IsChecked="{Binding UdPictures}" Margin="0,0,14,4" />
                            <CheckBox Content="Videos" IsChecked="{Binding UdVideos}" Margin="0,0,14,4" />
                            <CheckBox Content="Music" IsChecked="{Binding UdMusic}" Margin="0,0,14,4" />
                            <CheckBox Content="Favorites" IsChecked="{Binding UdFavorites}" Margin="0,0,14,4" />
                        </WrapPanel>
                    </GroupBox>
                    <Grid Grid.Row="4" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Custom folders (any drive)">
                            <DockPanel Margin="4">
                                <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                                    <Button Content="Add folder" Command="{Binding AddCustomPathCommand}" />
                                    <Button Content="Remove folder" Command="{Binding RemoveCustomPathCommand}" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding CustomPaths}" SelectedItem="{Binding SelectedCustomPath}" Height="70" />
                            </DockPanel>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Options" Margin="6,0,0,0">
                            <StackPanel Margin="4">
                                <CheckBox Content="Runtimes (reinstall list)" IsChecked="{Binding IncludeRuntimes}" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Empty folders:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox Width="290" ItemsSource="{Binding EmptyFolderModes}" SelectedItem="{Binding EmptyFolderMode}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================ KEYBOARD LAYOUTS ============================ -->
            <TabItem Header="Keyboard Layouts">
                <Grid Margin="6" IsEnabled="{Binding IsIdle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="100" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="170" MinHeight="60" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <Button Content="Discover keyboard layouts" Command="{Binding DiscoverKeyboardCommand}" FontWeight="SemiBold" />
                        <Button Content="Select custom layouts" Command="{Binding SelectKeyboardCommand}" CommandParameter="custom" />
                        <Button Content="Clear" Command="{Binding SelectKeyboardCommand}" CommandParameter="none" />
                    </WrapPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,4">
                        <TextBlock Text="{Binding KeyboardStatus}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding KeyboardInputText}" TextWrapping="Wrap" Foreground="#FF333399" />
                    </StackPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding KeyboardRows}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Selected" Width="62">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Layout" Width="1.3*" IsReadOnly="True" Binding="{Binding Info.LayoutText, Mode=OneWay}" />
                            <DataGridTextColumn Header="KLID" Width="80" IsReadOnly="True" Binding="{Binding Info.Klid, Mode=OneWay}" />
                            <DataGridTextColumn Header="Language" Width="70" IsReadOnly="True" Binding="{Binding Info.Language, Mode=OneWay}" />
                            <DataGridTextColumn Header="Custom" Width="90" IsReadOnly="True" Binding="{Binding CustomText, Mode=OneWay}" />
                            <DataGridTextColumn Header="In your list" Width="80" IsReadOnly="True" Binding="{Binding EnabledText, Mode=OneWay}" />
                            <DataGridTextColumn Header="Best backup source" Width="1.5*" IsReadOnly="True" Binding="{Binding SourceText, Mode=OneWay}" />
                            <DataGridTextColumn Header="Layout file" Width="90" IsReadOnly="True" Binding="{Binding Info.LayoutFile, Mode=OneWay}" />
                            <DataGridTextColumn Header="Why custom" Width="1.5*" IsReadOnly="True" Binding="{Binding Info.Evidence, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="3" Style="{StaticResource HSplit}" />
                    <WrapPanel Grid.Row="4" Margin="0,4,0,0">
                        <TextBlock Text="Restore from package (on the new Windows; open the package in Backup &amp; Recovery first):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,6" />
                        <Button Content="Install selected layouts" Command="{Binding InstallLayoutsCommand}" />
                        <Button Content="Restore language list and keyboard order" Command="{Binding RestoreLanguagesCommand}" />
                    </WrapPanel>
                    <DataGrid Grid.Row="5" ItemsSource="{Binding KeyboardRestoreRows}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Install" Width="55" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Layout" Width="*" IsReadOnly="True" Binding="{Binding Info.LayoutText, Mode=OneWay}" />
                            <DataGridTextColumn Header="KLID" Width="80" IsReadOnly="True" Binding="{Binding Info.Klid, Mode=OneWay}" />
                            <DataGridTextColumn Header="What will happen" Width="2*" IsReadOnly="True" Binding="{Binding Action, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============================ WINDOWS SETTINGS ============================ -->
            <TabItem Header="Windows Settings">
                <Grid Margin="6" IsEnabled="{Binding IsIdle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="100" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="190" MinHeight="60" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <Button Content="Discover Windows settings" Command="{Binding DiscoverSettingsCommand}" FontWeight="SemiBold" />
                        <Button Content="Select Recommended settings" Command="{Binding SelectSettingsCommand}" CommandParameter="recommended" />
                        <Button Content="Clear" Command="{Binding SelectSettingsCommand}" CommandParameter="none" />
                        <TextBlock Text="Group:" VerticalAlignment="Center" Margin="6,0,4,6" />
                        <ComboBox Width="190" Margin="0,0,0,6" ItemsSource="{Binding SettingGroupChoices}" SelectedItem="{Binding SettingsGroup}" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Text="{Binding SettingsStatus}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding SettingsView}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Selected" Width="62">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Group" Width="120" IsReadOnly="True" Binding="{Binding Item.Group, Mode=OneWay}" />
                            <DataGridTextColumn Header="Setting" Width="1.3*" IsReadOnly="True" Binding="{Binding Item.Name, Mode=OneWay}" />
                            <DataGridTextColumn Header="Value" Width="1.6*" IsReadOnly="True" Binding="{Binding Item.Summary, Mode=OneWay}" />
                            <DataGridTextColumn Header="How it is restored" Width="1.4*" IsReadOnly="True" Binding="{Binding Item.RestoreMethod, Mode=OneWay}" />
                            <DataGridTextColumn Header="Administrator" Width="85" IsReadOnly="True" Binding="{Binding AdminText, Mode=OneWay}" />
                            <DataGridTextColumn Header="Sign-out" Width="65" IsReadOnly="True" Binding="{Binding SignOutText, Mode=OneWay}" />
                            <DataGridTextColumn Header="Class" Width="95" IsReadOnly="True" Binding="{Binding Item.Classification, Mode=OneWay}" />
                            <DataGridTextColumn Header="Note" Width="*" IsReadOnly="True" Binding="{Binding Item.Note, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="3" Style="{StaticResource HSplit}" />
                    <StackPanel Grid.Row="4" Margin="0,4,0,0">
                        <WrapPanel>
                            <TextBlock Text="Restore from package (on the new Windows):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,6" />
                            <Button Content="Dry run settings" Command="{Binding SettingsDryRunCommand}" />
                            <Button Content="Apply selected settings" Command="{Binding ApplySettingsCommand}" FontWeight="SemiBold" />
                            <Button Content="Undo last settings restore" Command="{Binding UndoSettingsCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding SettingsRestoreStatus}" TextWrapping="Wrap" />
                    </StackPanel>
                    <DataGrid Grid.Row="5" ItemsSource="{Binding SettingActionRows}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Apply" Width="50" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Group" Width="120" IsReadOnly="True" Binding="{Binding Action.Group, Mode=OneWay}" />
                            <DataGridTextColumn Header="Setting" Width="*" IsReadOnly="True" Binding="{Binding Action.Name, Mode=OneWay}" />
                            <DataGridTextColumn Header="What will happen" Width="2*" IsReadOnly="True" Binding="{Binding Action.Description, Mode=OneWay}" />
                            <DataGridTextColumn Header="Administrator" Width="85" IsReadOnly="True" Binding="{Binding AdminText, Mode=OneWay}" />
                            <DataGridTextColumn Header="Sign-out" Width="65" IsReadOnly="True" Binding="{Binding SignOutText, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============================ MIGRATION PLAN ============================ -->
            <TabItem Header="Migration Plan">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="220" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="90" MinHeight="30" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" IsEnabled="{Binding IsIdle}">
                        <Button Content="Generate targeted plan" Command="{Binding GeneratePlanCommand}" FontWeight="SemiBold" />
                        <Button Content="Select all Recommended" Command="{Binding SelectRecommendedCommand}" />
                        <Button Content="Clear selection" Command="{Binding ClearPlanSelectionCommand}" />
                        <TextBlock Text="{Binding PlanSummary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,6" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Text="{Binding PlanStatus}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <Grid Grid.Row="2" IsEnabled="{Binding IsIdle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" MinWidth="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="250" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="300" MinWidth="120" />
                        </Grid.ColumnDefinitions>
                        <TreeView x:Name="PlanTree" ItemsSource="{Binding TreeRoots}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Counts}" Foreground="Gray" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <GridSplitter Grid.Column="1" Style="{StaticResource VSplit}" />
                        <DockPanel Grid.Column="2">
                            <WrapPanel DockPanel.Dock="Top">
                                <Button Content="Up" Command="{Binding UpCommand}" />
                                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="4,0,4,6" />
                                <TextBox Width="130" Margin="0,0,8,6" Text="{Binding ExplorerSearch, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                <TextBlock Text="View:" VerticalAlignment="Center" Margin="0,0,4,6" />
                                <ComboBox Width="118" Margin="0,0,8,6" ItemsSource="{Binding ViewModes}" SelectedItem="{Binding ViewMode}" />
                                <TextBlock Text="Sort:" VerticalAlignment="Center" Margin="0,0,4,6" />
                                <ComboBox Width="68" Margin="0,0,4,6" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SortMode}" />
                                <CheckBox Content="Descending" IsChecked="{Binding SortDescending}" VerticalAlignment="Center" Margin="0,0,0,6" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding CurrentPath}" Foreground="#FF333399" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,3,0,0">
                                <Button Content="Previous page" Command="{Binding PrevPageCommand}" Margin="0,0,4,0" Padding="6,1" MinHeight="22" />
                                <Button Content="Next page" Command="{Binding NextPageCommand}" Margin="0,0,6,0" Padding="6,1" MinHeight="22" />
                                <TextBlock Text="{Binding PageText}" Foreground="Gray" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <Grid MinHeight="110">
                                <DataGrid x:Name="DetailsList" ItemsSource="{Binding ExplorerItems}" SelectedItem="{Binding SelectedExplorerItem}" SelectionMode="Single"
                                          Visibility="{Binding IsDetailsView, Converter={StaticResource B2V}}" MouseDoubleClick="OnExplorerDoubleClick" CanUserSortColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="28">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" /></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Name" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                                        <Image Source="{Binding Image}" Width="16" Height="16" Margin="0,0,4,0" />
                                                        <TextBlock Text="{Binding Name}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Type" Width="*" IsReadOnly="True" Binding="{Binding TypeText, Mode=OneWay}" />
                                        <DataGridTextColumn Header="Size" Width="80" IsReadOnly="True" Binding="{Binding SizeText, Mode=OneWay}" />
                                        <DataGridTextColumn Header="Modified" Width="115" IsReadOnly="True" Binding="{Binding ModifiedText, Mode=OneWay}" />
                                        <DataGridTextColumn Header="Class" Width="95" IsReadOnly="True" Binding="{Binding ClassText, Mode=OneWay}" />
                                        <DataGridTextColumn Header="Note" Width="1.5*" IsReadOnly="True" Binding="{Binding Note, Mode=OneWay}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ListBox x:Name="IconList" ItemsSource="{Binding ExplorerItems}" SelectedItem="{Binding SelectedExplorerItem}"
                                         Visibility="{Binding IsIconView, Converter={StaticResource B2V}}" MouseDoubleClick="OnExplorerDoubleClick"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" Margin="2" ToolTip="{Binding ToolTip}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="0,2,2,0" />
                                                <Image Grid.Row="0" Grid.Column="1" Source="{Binding Image}" HorizontalAlignment="Center" Stretch="Uniform"
                                                       Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                       Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </DockPanel>
                        <GridSplitter Grid.Column="3" Style="{StaticResource VSplit}" />
                        <TabControl Grid.Column="4">
                            <TabItem Header="Details">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="4">
                                        <TextBox Text="{Binding DetailsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" />
                                        <TextBlock Text="Classification" FontWeight="SemiBold" Margin="0,10,0,2" />
                                        <TextBlock Text="{Binding Legend}" TextWrapping="Wrap" Foreground="#FF444444" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Dependencies">
                                <DataGrid ItemsSource="{Binding VisibleDependencies}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Component" Width="*" Binding="{Binding Component}" />
                                        <DataGridTextColumn Header="Depends on" Width="*" Binding="{Binding DependsOn}" />
                                        <DataGridTextColumn Header="Type" Width="90" Binding="{Binding Type}" />
                                        <DataGridTextColumn Header="Confidence" Width="80" Binding="{Binding Confidence}" />
                                        <DataGridTextColumn Header="Required action" Width="*" Binding="{Binding RequiredAction}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Recovery steps">
                                <DataGrid ItemsSource="{Binding VisibleComponents}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Item" Width="*" Binding="{Binding Name}" />
                                        <DataGridTextColumn Header="Method" Width="90" Binding="{Binding MigrationMethod}" />
                                        <DataGridTextColumn Header="Class" Width="90" Binding="{Binding Classification}" />
                                        <DataGridTextColumn Header="Destination" Width="*" Binding="{Binding DestinationRule}" />
                                        <DataGridTextColumn Header="Verification" Width="*" Binding="{Binding VerificationMethod}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                    <GridSplitter Grid.Row="3" Style="{StaticResource HSplit}" />
                    <DataGrid Grid.Row="4" ItemsSource="{Binding PlanIssues}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity" Width="80" Binding="{Binding Severity}" />
                            <DataGridTextColumn Header="Area" Width="110" Binding="{Binding Area}" />
                            <DataGridTextColumn Header="Message" Width="3*" Binding="{Binding Message}" />
                            <DataGridTextColumn Header="Path" Width="*" Binding="{Binding Path}" />
                            <DataGridTextColumn Header="Action" Width="*" Binding="{Binding RequiredAction}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============================ BACKUP & RECOVERY ============================ -->
            <TabItem Header="Backup &amp; Recovery">
                <TabControl Margin="4" IsEnabled="{Binding IsIdle}" x:Name="BackupTabs">
                    <TabItem Header="1. Backup">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="140" MinHeight="40" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <TextBlock Text="Destination (existing folder):" VerticalAlignment="Center" Margin="0,0,6,6" />
                                <Button DockPanel.Dock="Right" Content="Browse destination" Command="{Binding BrowseDestinationCommand}" />
                                <TextBox Text="{Binding Destination, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,6" VerticalContentAlignment="Center" />
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="{Binding DiskCheckText}" Foreground="#FF9A6200" TextWrapping="Wrap" />
                            <WrapPanel Grid.Row="2" Margin="0,4,0,0">
                                <Button Content="Preview / Dry run" Command="{Binding PreviewCommand}" />
                                <Button Content="Create backup" Command="{Binding CreateBackupCommand}" FontWeight="SemiBold" />
                                <Button Content="Retry failed files" Command="{Binding RetryFailedCommand}" />
                            </WrapPanel>
                            <DataGrid Grid.Row="3" ItemsSource="{Binding PreviewRows}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Category" Width="2*" Binding="{Binding Category}" />
                                    <DataGridTextColumn Header="Files" Width="70" Binding="{Binding Files}" />
                                    <DataGridTextColumn Header="Size" Width="90" Binding="{Binding Size}" />
                                    <DataGridTextColumn Header="Classes" Width="*" Binding="{Binding Classes}" />
                                    <DataGridTextColumn Header="Destination rule" Width="1.5*" Binding="{Binding Destination}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <GridSplitter Grid.Row="4" Style="{StaticResource HSplit}" />
                            <DataGrid Grid.Row="5" ItemsSource="{Binding PreviewIssues}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Severity" Width="80" Binding="{Binding Severity}" />
                                    <DataGridTextColumn Header="Area" Width="100" Binding="{Binding Area}" />
                                    <DataGridTextColumn Header="Message" Width="3*" Binding="{Binding Message}" />
                                    <DataGridTextColumn Header="Path" Width="*" Binding="{Binding Path}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="6" Margin="0,4,0,0">
                                <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding BackupStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="2. Verify and Test Restore">
                        <StackPanel Margin="8">
                            <DockPanel>
                                <TextBlock Text="Package:" VerticalAlignment="Center" Margin="0,0,6,6" />
                                <Button DockPanel.Dock="Right" Content="Open package" Command="{Binding OpenPackageCommand}" />
                                <TextBox Text="{Binding PackagePath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,6,6" />
                            </DockPanel>
                            <WrapPanel>
                                <Button Content="Verify backup" Command="{Binding VerifyCommand}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding VerifyStatus}" VerticalAlignment="Center" Margin="4,0,0,6" TextWrapping="Wrap" />
                            </WrapPanel>
                            <TextBlock Text="Verify is read-only: it re-hashes every file and checks the manifests; it never changes the package." Foreground="Gray" Margin="0,0,0,10" />
                            <DockPanel>
                                <TextBlock Text="Empty test folder:" VerticalAlignment="Center" Margin="0,0,6,6" />
                                <Button DockPanel.Dock="Right" Content="Browse test folder" Command="{Binding BrowseSandboxCommand}" />
                                <TextBox Text="{Binding Sandbox, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6" />
                            </DockPanel>
                            <WrapPanel>
                                <Button Content="Test restore (sandbox)" Command="{Binding TestRestoreCommand}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TestStatus}" VerticalAlignment="Center" Margin="4,0,0,6" />
                            </WrapPanel>
                            <TextBlock Text="Test restore copies the files into the empty test folder only and checks them byte-for-byte. Real Windows/Office folders are not touched." Foreground="Gray" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Open recovery plan" Command="{Binding OpenReportCommand}" CommandParameter="Reports\Recovery-Plan.html" />
                                <Button Content="Open Python plan" Command="{Binding OpenReportCommand}" CommandParameter="Reports\PYTHON-RECOVERY-PLAN.txt" />
                                <Button Content="Open backup report" Command="{Binding OpenReportCommand}" CommandParameter="Reports\Backup-Report.html" />
                                <Button Content="Open package folder" Command="{Binding OpenReportCommand}" CommandParameter="" />
                            </WrapPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="3. Readiness">
                        <DockPanel Margin="6">
                            <WrapPanel DockPanel.Dock="Top">
                                <Button Content="Refresh readiness" Command="{Binding ReadinessCommand}" />
                                <Button Content="Export readiness report" Command="{Binding ExportReadinessCommand}" />
                                <TextBlock Text="{Binding ReadinessOverall}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="8,0,0,6" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,4"
                                       Text="'Migration Ready' appears only when every line is Ready. Some lines can only be resolved by your explicit confirmation (tick 'Confirmed'). Do not delete Windows 10 before it shows Migration Ready." />
                            <DataGrid ItemsSource="{Binding ReadinessRows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="State" Width="95" IsReadOnly="True" Binding="{Binding Item.State, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Area" Width="100" IsReadOnly="True" Binding="{Binding Item.Area, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Item" Width="1.3*" IsReadOnly="True" Binding="{Binding Item.Name, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Reason" Width="2*" IsReadOnly="True" Binding="{Binding Item.Reason, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Action" Width="*" IsReadOnly="True" Binding="{Binding Item.Action, Mode=OneWay}" />
                                    <DataGridTemplateColumn Header="Confirmed" Width="75">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Confirmed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Item.Confirmable}"
                                                          ToolTip="{Binding Item.ConfirmLabel}" HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="4. Restore">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="80" MinHeight="50" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="120" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="105" MinHeight="60" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="Run this on the NEW Windows after installing your programs. 1) Choose the target profile for every source profile. 2) Check prerequisites. 3) Dry run. 4) Untick what you do not want. 5) Restore. Nothing is overwritten unless you allow it; registry values are applied only when ticked one by one." />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding ProfileMapRows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Source account" Width="*" IsReadOnly="True" Binding="{Binding Source.Account, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Source profile path" Width="*" IsReadOnly="True" Binding="{Binding Source.ProfilePath, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Files" Width="60" IsReadOnly="True" Binding="{Binding FileCount, Mode=OneWay}" />
                                    <DataGridTemplateColumn Header="Target profile on this computer" Width="1.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Choices}" Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="Drive mapping (e.g. D:=E:):" VerticalAlignment="Center" Margin="0,0,4,6" />
                                <TextBox Width="120" Margin="0,0,10,6" Text="{Binding DriveMap, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Allow overwrite (previous file is saved)" IsChecked="{Binding AllowOverwrite}" VerticalAlignment="Center" Margin="0,0,10,6" />
                                <Button Content="Check prerequisites" Command="{Binding PrereqCommand}" />
                                <Button Content="Dry run" Command="{Binding DryRunCommand}" />
                                <Button Content="Restore selected" Command="{Binding RestoreCommand}" FontWeight="SemiBold" />
                                <Button Content="Undo last restore" Command="{Binding UndoRestoreCommand}" />
                            </WrapPanel>
                            <TextBlock Grid.Row="3" Text="{Binding RestoreStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TabControl Grid.Row="4">
                                <TabItem Header="Prerequisites">
                                    <DataGrid ItemsSource="{Binding PrerequisiteIssues}" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Severity" Width="80" Binding="{Binding Severity}" />
                                            <DataGridTextColumn Header="Area" Width="90" Binding="{Binding Area}" />
                                            <DataGridTextColumn Header="Message" Width="2*" Binding="{Binding Message}" />
                                            <DataGridTextColumn Header="Action" Width="*" Binding="{Binding RequiredAction}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Files (dry run)">
                                    <DataGrid ItemsSource="{Binding RestoreFileOps}">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="Restore" Width="60" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Action" Width="100" IsReadOnly="True" Binding="{Binding Action, Mode=OneWay}" />
                                            <DataGridTextColumn Header="Target" Width="2*" IsReadOnly="True" Binding="{Binding Target, Mode=OneWay}" />
                                            <DataGridTextColumn Header="Category" Width="*" IsReadOnly="True" Binding="{Binding Category, Mode=OneWay}" />
                                            <DataGridTextColumn Header="Reason" Width="*" IsReadOnly="True" Binding="{Binding Reason, Mode=OneWay}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Registry (review)">
                                    <DataGrid ItemsSource="{Binding RestoreRegistryOps}">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="Apply" Width="50" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Key (HKCU)" Width="2*" IsReadOnly="True" Binding="{Binding KeyPath, Mode=OneWay}" />
                                            <DataGridTextColumn Header="Value" Width="*" IsReadOnly="True" Binding="{Binding ValueName, Mode=OneWay}" />
                                            <DataGridTextColumn Header="Type" Width="70" IsReadOnly="True" Binding="{Binding Type, Mode=OneWay}" />
                                            <DataGridTextColumn Header="Current (old)" Width="*" IsReadOnly="True" Binding="{Binding OldValue, Mode=OneWay}" />
                                            <DataGridTextColumn Header="From backup (new)" Width="*" IsReadOnly="True" Binding="{Binding NewValue, Mode=OneWay}" />
                                            <DataGridTextColumn Header="Blocked" Width="60" IsReadOnly="True" Binding="{Binding Blocked, Mode=OneWay}" />
                                            <DataGridTextColumn Header="Warning" Width="1.5*" IsReadOnly="True" Binding="{Binding Warning, Mode=OneWay}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Python environments">
                                    <DockPanel>
                                        <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                                            <Button Content="Recreate selected environment" Command="{Binding RecreatePythonCommand}" />
                                            <TextBlock Text="Shows the exact commands and asks before running them. Packages are installed from the official Python Package Index." Foreground="Gray" VerticalAlignment="Center" Margin="4,0,0,6" />
                                        </WrapPanel>
                                        <DataGrid ItemsSource="{Binding PackagePythonEnvs}" SelectedItem="{Binding SelectedPythonEnv}" IsReadOnly="True" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Environment" Width="2*" Binding="{Binding RootPath}" />
                                                <DataGridTextColumn Header="Python" Width="80" Binding="{Binding Version}" />
                                                <DataGridTextColumn Header="Arch" Width="60" Binding="{Binding Architecture}" />
                                                <DataGridTextColumn Header="Capture" Width="80" Binding="{Binding Overall}" />
                                                <DataGridTextColumn Header="Packages" Width="70" Binding="{Binding Packages.Count}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                            <GridSplitter Grid.Row="5" Style="{StaticResource HSplit}" />
                            <GroupBox Grid.Row="6" Header="Functional test checklist (file restore is not the same as a working program)">
                                <DockPanel>
                                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Save functional test results" Command="{Binding SaveFunctionalCommand}" Margin="6,2,0,0" />
                                <ListBox ItemsSource="{Binding FunctionalChecks}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><CheckBox IsChecked="{Binding Done}" Content="{Binding Text}" /></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                </DockPanel>
                            </GroupBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="2" Style="{StaticResource HSplit}" Margin="6,0" />

        <ListBox Grid.Row="3" x:Name="LogList" Margin="6,0,6,4" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="12"
                 VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" />

        <StatusBar Grid.Row="4">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0" MinWidth="70" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding StopWarning}" Foreground="DarkRed" FontWeight="SemiBold" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding LastActivityText}" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <ProgressBar Width="170" Height="14" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding CountText}" MinWidth="60" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding Operation}" FontWeight="SemiBold" Margin="0,0,8,0" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding Phase}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
