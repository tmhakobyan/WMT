<Window x:Class="WMT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workstation Migration Toolkit v3.0 (M1)" Width="1100" Height="740" MinWidth="820" MinHeight="520"
        FontFamily="Segoe UI, Sylfaen" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <Style TargetType="Button"><Setter Property="Padding" Value="12,3" /><Setter Property="Margin" Value="0,0,6,6" /></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="170" MinHeight="60" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Help" Click="OnHelp" />
            <MenuItem Header="Open log" Click="OnOpenLog" />
            <MenuItem Header="About" Click="OnAbout" />
        </Menu>

        <TabControl Grid.Row="1" Margin="6">
            <TabItem Header="Software">
                <DockPanel IsEnabled="{Binding IsIdle}" Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Discover software" Command="{Binding DiscoverSoftwareCommand}" />
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="8,0,4,6" />
                        <TextBox Width="220" Margin="0,0,10,6" Padding="2"
                                 Text="{Binding SoftwareSearch, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Select all" Command="{Binding SelectSoftwareCommand}" CommandParameter="all" />
                        <Button Content="Clear" Command="{Binding SelectSoftwareCommand}" CommandParameter="none" />
                        <Button Content="Invert" Command="{Binding SelectSoftwareCommand}" CommandParameter="invert" />
                        <Button Content="Office details" Command="{Binding OfficeDetailsCommand}" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SoftwareStatus}" TextWrapping="Wrap" Margin="0,0,0,2" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SoftwareSelectionText}" Margin="0,0,0,6" />
                    <GroupBox DockPanel.Dock="Bottom" Header="Office" Height="150" Margin="0,6,0,0">
                        <TextBox Text="{Binding OfficeDetailsText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" />
                    </GroupBox>
                    <DataGrid ItemsSource="{Binding FilteredSoftware}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" RowHeaderWidth="0" SelectionMode="Single"
                              EnableRowVirtualization="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Use" Width="44"
                                                    Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Name" Width="2*" IsReadOnly="True" Binding="{Binding Item.Name, Mode=OneWay}" />
                            <DataGridTextColumn Header="Publisher" Width="*" IsReadOnly="True" Binding="{Binding Item.Publisher, Mode=OneWay}" />
                            <DataGridTextColumn Header="Version" Width="110" IsReadOnly="True" Binding="{Binding Item.Version, Mode=OneWay}" />
                            <DataGridTextColumn Header="Architecture" Width="90" IsReadOnly="True" Binding="{Binding Item.Architecture, Mode=OneWay}" />
                            <DataGridTextColumn Header="Source" Width="150" IsReadOnly="True" Binding="{Binding Item.Source, Mode=OneWay}" />
                            <DataGridTextColumn Header="Type" Width="90" IsReadOnly="True" Binding="{Binding Item.Type, Mode=OneWay}" />
                            <DataGridTextColumn Header="Recovery method" Width="*" IsReadOnly="True" Binding="{Binding Item.RecoveryMethod, Mode=OneWay}" />
                            <DataGridTextColumn Header="Status" Width="90" IsReadOnly="True" Binding="{Binding Item.Confidence, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="User profiles">
                <DockPanel IsEnabled="{Binding IsIdle}" Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Discover profiles" Command="{Binding DiscoverProfilesCommand}" />
                        <Button Content="Select all" Command="{Binding SelectProfilesCommand}" CommandParameter="all" />
                        <Button Content="Clear" Command="{Binding SelectProfilesCommand}" CommandParameter="none" />
                        <Button Content="Invert" Command="{Binding SelectProfilesCommand}" CommandParameter="invert" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ProfilesStatus}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <DataGrid ItemsSource="{Binding Profiles}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" RowHeaderWidth="0" SelectionMode="Single" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Use" Width="44"
                                                    Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Account" Width="*" IsReadOnly="True" Binding="{Binding Item.Account, Mode=OneWay}" />
                            <DataGridTextColumn Header="SID" Width="2*" IsReadOnly="True" Binding="{Binding Item.Sid, Mode=OneWay}" />
                            <DataGridTextColumn Header="Profile path" Width="2*" IsReadOnly="True" Binding="{Binding Item.ProfilePath, Mode=OneWay}" />
                            <DataGridTextColumn Header="Loaded" Width="70" IsReadOnly="True" Binding="{Binding LoadedText, Mode=OneWay}" />
                            <DataGridTextColumn Header="Accessible" Width="90" IsReadOnly="True" Binding="{Binding Item.Access, Mode=OneWay}" />
                            <DataGridTextColumn Header="Last used" Width="130" IsReadOnly="True" Binding="{Binding LastUsedText, Mode=OneWay}" />
                            <DataGridTextColumn Header="Note" Width="2*" IsReadOnly="True" Binding="{Binding Item.AccessNote, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#FFBBBBBB" />

        <ListBox Grid.Row="3" x:Name="LogList" Margin="6,0,6,6" ItemsSource="{Binding LogLines}"
                 FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" />

        <StatusBar Grid.Row="4">
            <StatusBarItem DockPanel.Dock="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0" />
            </StatusBarItem>
            <StatusBarItem><TextBlock Text="{Binding Phase}" MinWidth="220" /></StatusBarItem>
            <StatusBarItem><TextBlock Text="{Binding CountText}" MinWidth="70" /></StatusBarItem>
            <StatusBarItem>
                <ProgressBar Width="160" Height="14" Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                             Visibility="{Binding IsBusy, Converter={StaticResource B2V}}" />
            </StatusBarItem>
            <StatusBarItem><TextBlock Text="{Binding LastActivityText}" /></StatusBarItem>
            <StatusBarItem><TextBlock Text="{Binding StopWarning}" Foreground="DarkRed" FontWeight="SemiBold" /></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
